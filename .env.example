# To create or update a token visit https://envio.dev/app/api-tokens
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"

# RPC URLs, used only by the `getTokenMetadata` effect (name/symbol/decimals via
# viem multicall) — indexing itself goes through HyperSync (Arc excepted: it syncs
# over ENVIO_RPC_URL_5042, see config.yaml). Set these to override
# the public drpc.org defaults in src/utils/tokenMetadata.ts.
#
# One slot per chain in config.yaml. `getRpcUrl` still carries cases for chains
# this fork no longer indexes; they are unreachable and deliberately not listed.
ENVIO_MAINNET_RPC_URL=""
ENVIO_SEPOLIA_RPC_URL=""
ENVIO_ROBINHOOD_RPC_URL=""
ENVIO_INK_RPC_URL=""
ENVIO_ARBITRUM_RPC_URL=""
# Falls back to ENVIO_RPC_URL_5042 (the sync RPC in config.yaml) before the public node.
ENVIO_ARC_RPC_URL=""
